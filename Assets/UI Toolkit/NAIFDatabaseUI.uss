
#DatabaseList {
    flex-grow: 1;
    margin-top: 8px;
}

.db-row {
    flex-direction: row;
    padding-left: 12px;
    padding-right: 12px;
    height: 30px;
    align-items: center;
}


.db-row.odd {
    background-color: rgba(255, 255, 255, 0.04);
}


.db-row:hover {
    background-color: rgba(255, 255, 255, 0.08);
}


.db-col {
    unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
